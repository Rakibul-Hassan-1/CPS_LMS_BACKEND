DATABASE_FILENAME=

DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=

# Comma separated list of allowed frontend origins for CORS
FRONTEND_URL=

# First Admin (application-role) account, auto-created on first boot if it
# doesn't exist yet. Change the password after first login.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
